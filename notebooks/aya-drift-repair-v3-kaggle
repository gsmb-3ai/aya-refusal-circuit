    "    def modules(self):\n",
    "        return sorted(self.A)\n",
    "\n",
    "    def delta(self, mod, device=\"cpu\"):\n",
    "        A, B = self.A[mod].to(device).float(), self.B[mod].to(device).float()\n",
    "        return self.scaling * (B @ A)\n",
