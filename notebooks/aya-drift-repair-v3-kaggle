    "class LoraDeltas:\n",
    "    \n",
    "\n",
    "    def __init__(self, adapter_dir):\n",
    "        d = Path(adapter_dir)\n",
    "        cfg = json.load(open(d / \"adapter_config.json\"))\n",
    "        self.scaling = cfg[\"lora_alpha\"] / cfg[\"r\"]\n",
    "        sd = load_file(str(d / \"adapter_model.safetensors\"))\n",
    "        self.A, self.B = {}, {}\n",
